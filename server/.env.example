# 백엔드(FastAPI) 환경변수 — 이 파일을 .env로 복사해 값을 채우세요.
# .env 는 커밋되지 않습니다.

# 한국관광공사 TourAPI 키
TOUR_API_KEY=your_tour_api_key

# PostgreSQL 연결 문자열
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/onttang

# 카카오 로그인 (카카오 개발자 콘솔)
KAKAO_REST_KEY=your_kakao_rest_api_key
KAKAO_CLIENT_SECRET=your_kakao_client_secret
# authorize 때와 동일해야 함 (카카오 콘솔 Redirect URI). 실기기는 맥 LAN IP:8081.
KAKAO_REDIRECT_URI=http://192.168.0.10:8081/kakao-bridge.html

# 자체 JWT 서명 키 (랜덤 문자열)
JWT_SECRET=your_random_jwt_secret

# 앱(Expo) 환경변수 — 이 파일을 .env로 복사해 값을 채우세요.
# .env 는 커밋되지 않습니다 (.gitignore).

# 네이버 지도 client id (app.config.ts 네이버맵 플러그인)
NAVER_MAP_CLIENT_ID=your_naver_map_client_id

# 실기기 개발 시 맥 LAN IP (예: 192.168.0.10).
# config.ts의 API_URL(:8000)과 카카오 브리지(:8081) 주소에 사용.
# 시뮬레이터만 쓰면 생략 가능 (미설정 시 localhost).
EXPO_PUBLIC_DEV_HOST=192.168.0.10
